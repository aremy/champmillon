---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import NewsCard from "@/components/NewsCard.astro";
import Agenda from "@/components/Agenda.astro";
import { getActualites, getAgenda } from "@/lib/content";

const actualites = await getActualites();
const agenda = await getAgenda();
---

<Base titre="Actualités" description="Les nouvelles et les rendez-vous de la commune.">
  <PageHeader
    titre="Actualités"
    description="Informations de la mairie, travaux, vie associative et rendez-vous à ne pas manquer."
  />
  <div class="conteneur mt-12 grid gap-12 lg:grid-cols-[2fr_1fr]">
    <section aria-label="Toutes les actualités">
      <div class="grid gap-5 sm:grid-cols-2">
        {actualites.map(item => <NewsCard item={item} level={2} />)}
      </div>
    </section>
    <aside id="agenda" class="lg:sticky lg:top-6 lg:self-start">
      <h2 class="text-3xl font-semibold">Agenda</h2>
      <div class="mt-6"><Agenda items={agenda} /></div>
    </aside>
  </div>
</Base>
