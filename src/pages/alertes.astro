---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getToutesAlertes, alerteFin, formatDate } from "@/lib/content";

const now = Date.now();
const alertes = await Promise.all(
  (await getToutesAlertes()).map(async a => ({
    a,
    Content: (await render(a)).Content,
    active: a.data.debut.getTime() <= now && now < alerteFin(a),
  })),
);
const NIVEAU = { urgent: "Alerte", vigilance: "Vigilance", info: "Information" } as const;
const BORDURE = { urgent: "border-l-alerte", vigilance: "border-l-cognac", info: "border-l-riviere" } as const;
---

<Base titre="Informations importantes" description="Alertes et annonces importantes de la commune : météo, crues, coupures, travaux.">
  <PageHeader
    titre="Alertes et annonces"
    description="Crues de la Charente, vigilance météo, coupures d'eau ou d'électricité, fermetures de route : les annonces importantes de la mairie, avec leur période de validité."
  />
  <div class="conteneur mt-12">
    <ol class="mx-auto max-w-3xl space-y-6">
      {
        alertes.map(({ a, Content, active }) => (
          <li id={a.id} class:list={["carte scroll-mt-28 border-l-8 p-6", BORDURE[a.data.niveau]]}>
            <p class="text-sm font-semibold">
              <span class={active ? "text-alerte" : "text-gris"}>{active ? "En cours" : "Terminée"}</span>
              <span class="text-gris">
                {" "}· {NIVEAU[a.data.niveau]} · du {formatDate(a.data.debut)} au {formatDate(a.data.fin)}
              </span>
            </p>
            <h2 class="mt-1 text-2xl font-semibold">{a.data.titre}</h2>
            <div class="texte mt-3">
              <Content />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
