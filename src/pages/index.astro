---
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import NewsCard from "@/components/NewsCard.astro";
import Agenda from "@/components/Agenda.astro";
import { getSite, getAccueil, getActualites, getAgenda, getJournaux, hasWebVersion } from "@/lib/content";

const site = await getSite();
const accueil = await getAccueil();
const actualites = (await getActualites()).slice(0, 3);
const agenda = (await getAgenda()).slice(0, 4);
const journal = (await getJournaux())[0];
const tel = site.mairie.telephone.replace(/\s/g, "");
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <Image
      src={accueil.photo}
      alt=""
      widths={[800, 1400, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="bg-riviere-fonce/55 absolute inset-0 -z-10"></div>
    <div class="conteneur py-24 sm:py-32">
      <h1 class="max-w-3xl text-5xl leading-tight font-semibold text-white sm:text-6xl">{accueil.titre}</h1>
      <p class="mt-5 max-w-xl text-lg text-white sm:text-xl">{accueil.texte}</p>
    </div>
  </section>

  <!-- Quick access -->
  <section aria-labelledby="acces" class="conteneur mt-10">
    <h2 id="acces" class="sr-only">Accès rapides</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        accueil.acces_rapides.map(t => (
          <li>
            <a href={t.lien} class="carte hover:border-riviere flex h-full items-center gap-3 p-4">
              <Icon name={t.icone} class="text-riviere shrink-0" />
              <span class="leading-snug font-semibold">{t.titre}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- News + agenda -->
  <section class="conteneur mt-16 grid gap-10 lg:grid-cols-[2fr_1fr]">
    <div>
      <h2 class="text-3xl font-semibold">Actualités</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3 lg:grid-cols-3">
        {actualites.map(item => <NewsCard item={item} />)}
      </div>
      <a href="/actualites/" class="lien mt-6 inline-block">Toutes les actualités</a>
    </div>
    <div>
      <h2 class="text-3xl font-semibold">Agenda</h2>
      <div class="mt-6"><Agenda items={agenda} /></div>
    </div>
  </section>

  <!-- Mairie + journal -->
  <section class="conteneur mt-16 grid gap-6 md:grid-cols-2">
    <div class="bg-riviere rounded-2xl p-8 text-white">
      <h2 class="text-3xl font-semibold text-white">La mairie</h2>
      <p class="mt-2">{site.mairie.adresse}</p>
      <dl class="mt-5 space-y-2">
        {
          site.mairie.horaires.map(h => (
            <div class="flex justify-between gap-4 border-b border-white/25 pb-2">
              <dt>{h.jour}</dt>
              <dd class="font-semibold">{h.heures}</dd>
            </div>
          ))
        }
      </dl>
      {site.mairie.note_horaires && <p class="mt-3 text-sm">{site.mairie.note_horaires}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${tel}`} class="bouton-clair"><Icon name="telephone" size={18} />{site.mairie.telephone}</a>
        <a href="/mairie/" class="bouton-clair">La mairie</a>
        <a href="/demarches/" class="bouton-clair">Démarches</a>
      </div>
    </div>

    {
      journal && (
        <div class="carte flex flex-col p-8">
          <h2 class="text-3xl font-semibold">Le journal {journal.data.annee}</h2>
          <p class="mt-2 text-lg font-semibold">{journal.data.titre}</p>
          <p class="text-gris mt-2 flex-1">{journal.data.resume}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            {hasWebVersion(journal) && (
              <a class="bouton" href={`/journal/${journal.id}/`}>
                Lire en ligne
              </a>
            )}
            {journal.data.pdf && (
              <a class="bouton" href={journal.data.pdf} download>
                <Icon name="telecharger" size={18} /> PDF
              </a>
            )}
          </div>
          <a class="lien mt-4 self-start" href="/journal/">Toutes les éditions</a>
        </div>
      )
    }
  </section>

  <!-- Discover -->
  {
    accueil.decouvrir && (
      <section class="conteneur mt-16">
        <h2 class="text-3xl font-semibold">{accueil.decouvrir.titre}</h2>
        <p class="text-gris mt-2 text-lg">{accueil.decouvrir.texte}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-3">
          {accueil.decouvrir.photos.map(p => (
            <li>
              <figure>
                <Image src={p.photo} alt="" widths={[500, 800]} sizes="(min-width: 640px) 33vw, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover" />
                <figcaption class="mt-2 font-semibold">{p.legende}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <a href="/village/" class="lien mt-6 inline-block">Découvrir le village</a>
      </section>
    )
  }
</Base>
