---
import Base from "@/layouts/Base.astro";
---

<Base titre="Page introuvable">
  <section class="conteneur py-24 text-center">
    <p class="surtitre">Erreur 404</p>
    <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">Cette page n'existe pas (ou plus)</h1>
    <p class="text-gris mx-auto mt-4 max-w-xl text-lg">
      Elle a peut-être été déplacée. Le menu ou la page d'accueil vous aideront à retrouver votre chemin.
    </p>
    <a href="/" class="bouton mt-8">Retour à l'accueil</a>
  </section>
</Base>
